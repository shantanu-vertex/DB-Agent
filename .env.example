# GitHub Models (OpenAI-compatible endpoint used by the in-app LLM call).
# Generate a token at https://github.com/settings/tokens with the
# "models:read" scope. Claude Code consumes this agent's MCP server
# externally — it does not need a key set here.
GITHUB_TOKEN=
GITHUB_COPILOT_MODEL=gpt-4o

# Postgres connection (read-only role recommended)
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public

# Where the generated Postgres schema JSON cache is stored
SCHEMA_CACHE_PATH=cache/schema.json

# vertexinc/oseries clone (XML schema source — no DB connection needed)
OSERIES_ROOT=C:/dev/oseries
# Optional comma-separated module filter, e.g. tps,util,rte
OSERIES_MODULES=
OSERIES_CACHE_PATH=cache/oseries_schema.json
