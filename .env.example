# ── LLM provider (choose one) ────────────────────────────────────────────────
# Option 1: GitHub Models (free with any GitHub account — recommended)
#   Get your token: https://github.com/settings/tokens  (no scopes needed)
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# Option 2: Standard OpenAI (requires paid API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/your_database
